    {
        "DisplayName": "Public IP",
        "Category": "Open77:sports_esports",
        "Subcategory": "Network:lan:2",
        "Description": "The public IPv4 or IPv6 address of this host (no port). The server uses it to advertise the game and resource download addresses to players. It does not detect this itself. Loopback and 0.0.0.0 are rejected",
