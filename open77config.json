    {
        "DisplayName": "Public IP",
        "Category": "Open77:sports_esports",
        "Subcategory": "Network:lan:2",
        "Description": "The IPv4 or IPv6 address players use to reach this host (no port). It fills in the game and resource download addresses advertised to players. Use your router's internet IP (and forward the ports) for internet players, or this machine's LAN IP for players on your network only. The server does not detect it itself. Either this or Public Endpoint Override must be set",
        "Keywords": "public,ip,address,lan",
        "FieldName": "PublicIP",
        "InputType": "text",
        "ParamFieldName": "public-ip",
        "IncludeInCommandLine": true,
        "SkipIfEmpty": true,
        "DefaultValue": "",
        "Placeholder": "203.0.113.10",
        "EnumValues": {}
    },
    {
        "DisplayName": "Public Endpoint Override",
        "Category": "Open77:sports_esports",
        "Subcategory": "Network:lan:2",
        "Description": "HOST:PORT advertised to players instead of Public IP plus the game port. Use it for a hostname (for example dynamic DNS), or when NAT maps a different external port. If you use a hostname without Public IP, also set Public Download URL Override",
        "Keywords": "public,endpoint,hostname,nat",
        "FieldName": "PublicEndpoint",
        "InputType": "text",
        "ParamFieldName": "network.publicEndpoint",
        "IncludeInCommandLine": true,
        "SkipIfEmpty": true,
        "DefaultValue": "",
        "Placeholder": "play.example.com:11778",
        "EnumValues": {}
    },
    {
        "DisplayName": "Public Download URL Override",
        "Category": "Open77:sports_esports",
        "Subcategory": "Network:lan:2",
        "Description": "Public base URL for resource downloads, for example http://play.example.com:11779/ or an HTTPS reverse proxy in front of the download port. Required when Public IP is empty, otherwise players are told to download from 127.0.0.1. Leave empty to use http://PublicIP:DownloadPort/",
        "Keywords": "download,url,https,proxy,resources",
        "FieldName": "PublicDownloadUrl",
        "InputType": "text",
        "ParamFieldName": "resources.download.publicBaseUrl",
        "IncludeInCommandLine": true,
        "SkipIfEmpty": true,
        "DefaultValue": "",
        "Placeholder": "https://cdn.example.com/",
        "EnumValues": {}
    },
    {
        "DisplayName": "Enable Warden Admin Panel",
        "Category": "Open77:sports_esports",
        "Subcategory": "Admin:admin_panel_settings:3",
        "Description": "Enables the Warden web panel on the Warden port. On first start, a one-time setup PIN is printed to the console to create the admin account. Warden is plain HTTP: put it behind a TLS reverse proxy or firewall it off",
        "Keywords": "warden,admin,panel,web",
        "FieldName": "WardenEnabled",
        "InputType": "checkbox",
        "ParamFieldName": "warden.enabled",
        "IncludeInCommandLine": true,
        "DefaultValue": "false",
        "EnumValues": {
            "True": "true",
            "False": "false"
        }
    },
